<?xml version="1.0" encoding="ISO-8859-1"?>

<alg_conf>

<!--

Configuration sets for DISHadronSystemGenerator EventRecordVisitorI

Algorithm Configurable Parameters:
.......................................................................................................................
Name                Type    Opt   Comment                                                   Default
.......................................................................................................................
Hadronizer          alg     No
PreTransportDecayer alg     No
FilterPreFragm      bool    No
FormationZoneModel  alg     No    Formation zone model (StandardFZModel or LundStringFZModel)
NUCL-R0             double  No                                                              CommonParam[NUCL]
NUCL-NR             double  No                                                              CommonParam[NUCL]
-->

  <param_set name="Default">
     <param type="string"  name="CommonParam"> NUCL </param>

     <param type="alg"  name="Hadronizer">          genie::AGKY2019/Default                 </param>
     <param type="alg"  name="PreTransportDecayer"> genie::UnstableParticleDecayer/BeforeHadronTransport  </param>
     <param type="bool" name="FilterPreFragm">      false                                                 </param>

     <!--
          ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
          Formation zone model. Available options:
            genie::StandardFZModel/Default      GENIE standard model (fixed formation zone)
            genie::StandardFZModel/Exp          GENIE standard model, sampled from an exponential
            genie::LundStringFZModel/Default    Lund string model (fixed formation zone)
            genie::LundStringFZModel/Exp        Lund string model, sampled from an exponential
     -->
     <param type="alg"  name="FormationZoneModel">  genie::StandardFZModel/Default         </param>

  </param_set>

  <param_set name="Charm">
     <param type="alg"  name="Hadronizer">          genie::AGCharmPythia8Hadro2023/Default                     </param>
     <param type="alg"  name="PreTransportDecayer"> genie::UnstableParticleDecayer/BeforeHadronTransport  </param>
     <param type="bool" name="FilterPreFragm">      false                                                 </param>

  </param_set>

</alg_conf>
